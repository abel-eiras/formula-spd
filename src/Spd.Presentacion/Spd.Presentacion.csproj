<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Fuente única de la versión: la lee el comprobador de actualizaciones del ensamblado, y es la
         que debe coincidir con la etiqueta de la release en GitHub (con o sin `v` delante). -->
    <Version>0.1.0</Version>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
    <!-- Spec 014 FR-1405: la ayuda es documentación versionada con el código (Art. XI.5) -->
    <EmbeddedResource Include="Ayuda\*.md" />
  </ItemGroup>

  <ItemGroup>
    <!-- Constitución Art. VIII.2 fija Avalonia UI 11 (no 12): pinnado explícito a la última 11.x estable -->
    <PackageReference Include="Avalonia" Version="11.3.20" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.3.13" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.20" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.20" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.20" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <ProjectReference Include="..\Spd.Aplicacion\Spd.Aplicacion.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Spd.Infraestructura\Spd.Infraestructura.csproj" />
  </ItemGroup>
</Project>
