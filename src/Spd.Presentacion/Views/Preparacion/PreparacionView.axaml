<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Spd.Presentacion.Controles"
             x:Class="Spd.Presentacion.Views.Preparacion.PreparacionView">
  <Grid RowDefinitions="Auto,*,Auto" Margin="16">
    <StackPanel Grid.Row="0" Spacing="6">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <Button Content="Nueva sesión de preparación" Command="{Binding NuevaSesionCommand}" />
        <Button Content="Preparar siguiente" Command="{Binding PrepararSiguienteCommand}" />
        <Button Content="Imprimir instrucciones de la sesión" Command="{Binding ImprimirInstruccionesSesionCommand}" />
      </StackPanel>
      <Border Padding="8" Background="#22808080">
        <StackPanel Spacing="4">
          <TextBlock Text="Entrega (los datos se aplican a todos los blísteres VERIFICADOS)" FontWeight="Bold" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBox Watermark="Entregado a" Text="{Binding EntregadoA}" Width="200" />
            <CheckBox Content="Primera entrega" IsChecked="{Binding PrimeraEntrega}" />
            <CheckBox Content="SPD anterior recogido" IsChecked="{Binding SpdAnteriorRecogido}" />
            <CheckBox Content="Refiere cambios de medicación" IsChecked="{Binding CambiosMedicacionReferidos}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBox Watermark="Unidades no administradas (p. ej. Paracetamol: 2)" Text="{Binding UnidadesNoAdministradas}" Width="300" />
            <TextBox Watermark="Observaciones de adherencia" Text="{Binding ObservacionesAdherencia}" Width="300" />
            <Button Content="Entregar todos los pendientes" Command="{Binding EntregarTodosLosPendientesCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>

    <ScrollViewer Grid.Row="1" Margin="0,12,0,0">
      <StackPanel Spacing="16">
        <Border Padding="8" Background="#22808080">
          <StackPanel Spacing="4">
            <TextBlock Text="Condiciones ambientales y material" FontWeight="Bold" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <NumericUpDown Value="{Binding Temperatura}" Watermark="Temp. °C" Width="130" />
              <NumericUpDown Value="{Binding Humedad}" Watermark="Humedad %" Width="130" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <ComboBox ItemsSource="{Binding MaterialesDisponibles}" SelectedItem="{Binding MaterialSeleccionado}" Width="220">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Descripcion}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBox Watermark="Descripción material nuevo" Text="{Binding NuevoMaterialDescripcion}" />
              <TextBox Watermark="Lote" Text="{Binding NuevoMaterialLote}" Width="100" />
              <Button Content="Crear material" Command="{Binding CrearMaterialCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <ListBox ItemsSource="{Binding Blisteres}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border Padding="8" Margin="0,4" BorderThickness="1" BorderBrush="#33808080">
                <StackPanel Spacing="4">
                  <TextBlock FontWeight="Bold">
                    <TextBlock.Text>
                      <MultiBinding StringFormat="{}{0} — {1} (v{2})">
                        <Binding Path="Spd.NumRegistro" />
                        <Binding Path="Spd.Estado" />
                        <Binding Path="Spd.Version" />
                      </MultiBinding>
                    </TextBlock.Text>
                  </TextBlock>
                  <TextBlock>
                    <TextBlock.Text>
                      <MultiBinding StringFormat="Validez: {0:d} — {1:d}">
                        <Binding Path="Spd.ValidezDesde" />
                        <Binding Path="Spd.ValidezHasta" />
                      </MultiBinding>
                    </TextBlock.Text>
                  </TextBlock>
                  <!-- FR-1540: el carril dice en qué paso va el blíster y, si algo está bloqueado,
                       por qué; antes eso solo se descubría al pulsar y recibir un error. -->
                  <c:CarrilPasos DataContext="{Binding Pasos}" Margin="0,8" />

                  <!-- FR-1541: el blíster como se ve. Evita traducir mentalmente "½-0-1-0, de lunes
                       a viernes" a la posición física de cada alvéolo, que es donde se falla. -->
                  <c:RejillaAlveolos DataContext="{Binding Rejilla}" Margin="0,4,0,10" />

                  <ItemsControl ItemsSource="{Binding Lineas}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock FontSize="11">
                            <TextBlock.Text>
                              <MultiBinding StringFormat="{}{0} — {1} uds/envase ({2})">
                                <Binding Path="SnapNombre" />
                                <Binding Path="UnidadesEnvase" />
                                <Binding Path="EstadoLinea" />
                              </MultiBinding>
                            </TextBlock.Text>
                          </TextBlock>
                          <Button Content="Registrar envase" FontSize="10"
                                  Command="{Binding DataContext.PrepararRegistroEnvaseCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                  CommandParameter="{Binding}" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Pasar a preparado" FontSize="11" IsEnabled="{Binding PuedeCerrarLlenado}"
                            Command="{Binding DataContext.PasarAPreparadoCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                            CommandParameter="{Binding}" />
                    <Button Content="Verificar" FontSize="11" IsEnabled="{Binding PuedeVerificar}"
                            Command="{Binding DataContext.PrepararVerificacionCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                            CommandParameter="{Binding}" />
                    <Button Content="Reelaborar" FontSize="11"
                            Command="{Binding DataContext.PrepararReelaboracionCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                            CommandParameter="{Binding}" />
                    <Button Content="Imprimir ficha" FontSize="11"
                            Command="{Binding DataContext.ImprimirFichaCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                            CommandParameter="{Binding}" />
                    <Button Content="Imprimir etiquetas" FontSize="11" IsEnabled="{Binding PuedeImprimirEtiquetas}"
                            Command="{Binding DataContext.ImprimirEtiquetasCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                            CommandParameter="{Binding}" />
                    <Button Content="Imprimir instrucciones" FontSize="11" IsEnabled="{Binding PuedeImprimirInstrucciones}"
                            Command="{Binding DataContext.ImprimirInstruccionesCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                            CommandParameter="{Binding}" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <Border Padding="8" Background="#22808080" IsVisible="{Binding BlisterEnVerificacion, Converter={x:Static ObjectConverters.IsNotNull}}">
          <StackPanel Spacing="4">
            <TextBlock Text="Verificación final del SPD (8 preguntas del Anexo I.G, todas obligatorias)" FontWeight="Bold" />
            <CheckBox Content="1. ¿El contenido del DDP es correcto? (comprobar con la ficha del paciente)" IsChecked="{Binding CheckContenido}" />
            <CheckBox Content="2. ¿Se siguieron las instrucciones del fabricante y los PNT durante todo el proceso?" IsChecked="{Binding CheckFabricantePnt}" />
            <CheckBox Content="3. ¿Coinciden los datos del DDP de la etiqueta con la ficha de preparación, control y entrega?" IsChecked="{Binding CheckEtiquetaDatos}" />
            <CheckBox Content="4. ¿Coinciden los datos de la etiqueta y la ficha del paciente a fecha de hoy?" IsChecked="{Binding CheckEtiquetaFichaPaciente}" />
            <CheckBox Content="5. ¿Se garantizó la trazabilidad entre el envase original y el DDP acondicionado?" IsChecked="{Binding CheckTrazabilidad}" />
            <CheckBox Content="6. ¿El DDP está identificado con su periodo de validez?" IsChecked="{Binding CheckEtiquetaValidez}" />
            <CheckBox Content="7. ¿Se cumplimentó la hoja de instrucciones según la normativa vigente?" IsChecked="{Binding CheckInstrucciones}" />
            <CheckBox Content="8. ¿Está libre de alteraciones visibles? (rotura, cartón arrugado, fallos en el cierre…)" IsChecked="{Binding CheckAspecto}" />
            <ComboBox ItemsSource="{Binding VerificadoresDisponibles}" SelectedItem="{Binding VerificadorSeleccionado}"
                      HorizontalAlignment="Stretch" PlaceholderText="Quién verifica…">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock>
                    <TextBlock.Text>
                      <MultiBinding StringFormat="{}{0} {1} · {2}">
                        <Binding Path="Nombre" />
                        <Binding Path="Apellidos" />
                        <Binding Path="Rol" />
                      </MultiBinding>
                    </TextBlock.Text>
                  </TextBlock>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBox Watermark="Motivo de excepción (si verificador = elaborador)" Text="{Binding ExcepcionMotivo}" />
            <Button Content="Confirmar verificación" Command="{Binding ConfirmarVerificacionCommand}" />
          </StackPanel>
        </Border>

        <Border Padding="8" Background="#22808080" IsVisible="{Binding BlisterEnReelaboracion, Converter={x:Static ObjectConverters.IsNotNull}}">
          <StackPanel Spacing="4">
            <TextBlock Text="Reelaborar" FontWeight="Bold" />
            <ComboBox ItemsSource="{Binding OrigenesDisponibles}" SelectedItem="{Binding OrigenReelaboracion}" />
            <TextBox Watermark="Motivo" Text="{Binding MotivoReelaboracion}" />
            <Button Content="Confirmar reelaboración" Command="{Binding ConfirmarReelaboracionCommand}" />
          </StackPanel>
        </Border>

        <Border Padding="8" Background="#22808080" IsVisible="{Binding LineaParaRegistrarEnvase, Converter={x:Static ObjectConverters.IsNotNull}}">
          <StackPanel Spacing="4">
            <TextBlock Text="{Binding LineaParaRegistrarEnvase.SnapNombre, StringFormat='Registrar envase: {0}'}" FontWeight="Bold" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBox Watermark="Serie" Text="{Binding EnvaseSerie}" />
              <TextBox Watermark="Lote" Text="{Binding EnvaseLote}" />
              <DatePicker SelectedDate="{Binding EnvaseCaducidad}" />
              <NumericUpDown Value="{Binding EnvaseUnidadesIniciales}" Minimum="0" Watermark="Unidades" />
              <Button Content="Guardar" Command="{Binding ConfirmarRegistroEnvaseCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Padding="16,8" Background="#22808080"
            IsVisible="{Binding Mensaje, Converter={x:Static ObjectConverters.IsNotNull}}">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="¿Por qué? (F1)" FontSize="11" Click="Porque_Click" Margin="8,0,0,0" />
        <TextBlock Text="{Binding Mensaje}" TextWrapping="Wrap" VerticalAlignment="Center" />
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
