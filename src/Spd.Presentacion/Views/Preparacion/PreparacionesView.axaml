<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Spd.Presentacion.Views.Preparacion.PreparacionesView">
  <Grid RowDefinitions="Auto,*,Auto" Margin="16">
    <StackPanel Grid.Row="0" Spacing="6">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBox Watermark="Paciente" Text="{Binding FiltroPaciente}" Width="220" />
        <TextBlock Text="Estado:" VerticalAlignment="Center" />
        <ComboBox ItemsSource="{Binding EstadosDisponibles}" SelectedItem="{Binding FiltroEstado}" Width="140" />
        <CheckBox Content="Solo pendientes (borrador, preparado, verificado)" IsChecked="{Binding SoloPendientes}" />
        <Button Content="Actualizar" Command="{Binding CargarCommand}" />
      </StackPanel>
      <Border Padding="8" Background="#22808080">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="Lote:" FontWeight="Bold" VerticalAlignment="Center" />
          <Button Content="Seleccionar los que están al día" Command="{Binding SeleccionarAlDiaCommand}" />
          <CheckBox Content="Ficha" IsChecked="{Binding LoteFicha}" />
          <CheckBox Content="Etiquetas" IsChecked="{Binding LoteEtiquetas}" />
          <CheckBox Content="Instrucciones" IsChecked="{Binding LoteInstrucciones}" />
          <Button Content="Generar documentos de los seleccionados" Command="{Binding GenerarLoteCommand}" />
        </StackPanel>
      </Border>
    </StackPanel>

    <ListBox Grid.Row="1" Margin="0,8,0,0" ItemsSource="{Binding Filas}">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2">
            <CheckBox Grid.Column="0" IsChecked="{Binding Seleccionado}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <StackPanel Grid.Column="1">
              <TextBlock FontWeight="Bold">
                <TextBlock.Text>
                  <MultiBinding StringFormat="{}{0} (ficha {1})">
                    <Binding Path="Paciente" />
                    <Binding Path="NumFicha" />
                  </MultiBinding>
                </TextBlock.Text>
              </TextBlock>
              <TextBlock Text="{Binding Resumen}" FontSize="11" />
              <TextBlock Text="{Binding EnvasesAlDiaTexto, StringFormat='Envases al día: {0}'}" FontSize="11" />
            </StackPanel>
            <Button Grid.Column="2" Content="Abrir preparación" FontSize="11" VerticalAlignment="Center"
                    Command="{Binding DataContext.AbrirPreparacionCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                    CommandParameter="{Binding}" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <Border Grid.Row="2" Padding="16,8" Background="#22808080"
            IsVisible="{Binding Mensaje, Converter={x:Static ObjectConverters.IsNotNull}}">
      <TextBlock Text="{Binding Mensaje}" TextWrapping="Wrap" />
    </Border>
  </Grid>
</UserControl>
