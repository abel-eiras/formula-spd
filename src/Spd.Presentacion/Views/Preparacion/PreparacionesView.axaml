<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Spd.Presentacion.Controles"
             x:Class="Spd.Presentacion.Views.Preparacion.PreparacionesView">
  <Grid>
  <Grid RowDefinitions="Auto,*,Auto" Margin="24,20">
    <StackPanel Grid.Row="0" Spacing="8">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Classes="primario" Content="Nueva preparación…" Command="{Binding AbrirNuevaPreparacionCommand}" />
        <TextBox Watermark="Filtrar por paciente" Text="{Binding FiltroPaciente}" Width="220" />
        <TextBlock Text="Estado:" Classes="etiqueta" VerticalAlignment="Center" />
        <ComboBox ItemsSource="{Binding EstadosDisponibles}" SelectedItem="{Binding FiltroEstado}" Width="150" />
        <CheckBox Content="Solo pendientes" IsChecked="{Binding SoloPendientes}" />
        <Button Content="Actualizar" Command="{Binding CargarCommand}" />
      </StackPanel>
      <Border Classes="panel">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="Lote" Classes="etiqueta" VerticalAlignment="Center" />
          <Button Classes="enlace" Content="Seleccionar los que están al día" Command="{Binding SeleccionarAlDiaCommand}" />
          <CheckBox Content="Ficha" IsChecked="{Binding LoteFicha}" />
          <CheckBox Content="Etiquetas" IsChecked="{Binding LoteEtiquetas}" />
          <CheckBox Content="Instrucciones" IsChecked="{Binding LoteInstrucciones}" />
          <Button Classes="primario" Content="Generar documentos de los seleccionados" Command="{Binding GenerarLoteCommand}" />
        </StackPanel>
      </Border>
    </StackPanel>

    <!-- FR-1512: tabla con cabeceras ordenables. La selección para el lote vive en cada fila
         (`Seleccionado`), no en el índice de la rejilla: por eso reordenar por cualquier columna no
         pierde lo que el usuario llevaba marcado. -->
    <DataGrid Grid.Row="1" Margin="0,12,0,0" ItemsSource="{Binding Filas}"
              AutoGenerateColumns="False" IsReadOnly="False"
              SelectionMode="Single" CanUserSortColumns="True">
      <DataGrid.Columns>
        <DataGridCheckBoxColumn Header="" Binding="{Binding Seleccionado}" Width="40" CanUserSort="False" />
        <DataGridTextColumn Header="Ficha" Binding="{Binding NumFicha}" Width="90" IsReadOnly="True" />
        <DataGridTextColumn Header="Paciente" Binding="{Binding Paciente}" Width="2*" IsReadOnly="True" />
        <DataGridTextColumn Header="Nº registro" Binding="{Binding Spd.NumRegistro}" Width="130" IsReadOnly="True" />
        <DataGridTextColumn Header="Estado" Binding="{Binding Spd.Estado}" Width="110" IsReadOnly="True" />
        <DataGridTextColumn Header="Validez" Width="150" IsReadOnly="True">
          <DataGridTextColumn.Binding>
            <MultiBinding StringFormat="{}{0:dd/MM} – {1:dd/MM}">
              <Binding Path="Spd.ValidezDesde" />
              <Binding Path="Spd.ValidezHasta" />
            </MultiBinding>
          </DataGridTextColumn.Binding>
        </DataGridTextColumn>
        <DataGridTextColumn Header="Elaborador" Binding="{Binding Elaborador}" Width="*" IsReadOnly="True" />
        <DataGridTextColumn Header="Verificador" Binding="{Binding Verificador}" Width="*" IsReadOnly="True" />
        <DataGridTextColumn Header="Envases" Binding="{Binding EnvasesAlDiaTexto}" Width="140" IsReadOnly="True" />
        <DataGridTemplateColumn Header="" Width="130" CanUserSort="False">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <Button Classes="enlace" Content="Abrir" VerticalAlignment="Center"
                      Command="{Binding DataContext.AbrirPreparacionCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                      CommandParameter="{Binding}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>

    <Border Grid.Row="2" Classes="panel" Margin="0,12,0,0"
            IsVisible="{Binding Mensaje, Converter={x:Static ObjectConverters.IsNotNull}}">
      <TextBlock Text="{Binding Mensaje}" TextWrapping="Wrap" />
    </Border>
  </Grid>

    <c:PanelLateral Titulo="Nueva preparación" IsVisible="{Binding PanelNuevaAbierto}"
                    CerrarCommand="{Binding CerrarNuevaPreparacionCommand}">
      <StackPanel Spacing="8">
        <TextBlock Classes="suave" TextWrapping="Wrap"
                   Text="Busca al paciente. Se abre su sesión y vas directamente a su preparación." />
        <TextBox Text="{Binding BusquedaPaciente}" Watermark="Paciente (mínimo 2 letras)…" />
        <ItemsControl ItemsSource="{Binding Candidatos}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Classes="tarjeta" Margin="0,0,0,8" Padding="12,10">
                <StackPanel Spacing="4">
                  <TextBlock Text="{Binding Etiqueta}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Detalle}" Classes="etiqueta" />
                  <TextBlock Text="{Binding UltimaTexto}" Classes="suave" TextWrapping="Wrap" />
                  <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                    <Button Classes="primario" Content="Preparar siguiente (desde la última)"
                            IsVisible="{Binding PuedePrepararSiguiente}"
                            Command="{Binding DataContext.PrepararSiguienteParaCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}" />
                    <Button Content="Sesión nueva"
                            Command="{Binding DataContext.CrearSesionParaCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="{Binding MensajeNueva}" TextWrapping="Wrap" Foreground="{DynamicResource Bloqueo}"
                   IsVisible="{Binding MensajeNueva, Converter={x:Static ObjectConverters.IsNotNull}}" />
      </StackPanel>
    </c:PanelLateral>
  </Grid>
</UserControl>
