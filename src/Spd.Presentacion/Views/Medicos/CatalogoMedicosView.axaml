<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Spd.Presentacion.Controles"
             x:Class="Spd.Presentacion.Views.Medicos.CatalogoMedicosView">
  <Grid ColumnDefinitions="1.6*,*" RowDefinitions="*,Auto" Margin="24,20">
    <StackPanel Grid.Column="0" Grid.Row="0" Spacing="8">
      <TextBlock Text="Catálogo de médicos" Classes="titulo" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBox Text="{Binding Fragmento}" Watermark="Apellidos, nombre o centro…" Width="260" />
        <Button Classes="primario" Content="Nuevo médico" Command="{Binding NuevoCommand}" />
        <Button Classes="enlace" Content="Actualizar" Command="{Binding RecargarCommand}" />
      </StackPanel>

      <!-- Sin x:DataType a propósito: bindings por reflexión (regresión de Spec 000). -->
      <DataGrid ItemsSource="{Binding Resultados}" AutoGenerateColumns="False"
                IsReadOnly="True" CanUserSortColumns="True">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Médico" Binding="{Binding Etiqueta}" Width="2*" />
          <DataGridTextColumn Header="Colegiado" Binding="{Binding Medico.Colegiado}" Width="110" />
          <DataGridTextColumn Header="Especialidad" Binding="{Binding Medico.Especialidad}" Width="*" />
          <DataGridTextColumn Header="Pacientes" Binding="{Binding PacientesDeCabecera}" Width="90"
                              CellStyleClasses="cifra" />
          <DataGridTemplateColumn Header="" Width="160" CanUserSort="False">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <Button Classes="enlace" Content="Abrir"
                          Command="{Binding DataContext.AbrirCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                          CommandParameter="{Binding}" />
                  <Button Classes="enlace" Content="Dar de baja" IsEnabled="{Binding SePuedeDarDeBaja}"
                          Command="{Binding DataContext.DarDeBajaCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                          CommandParameter="{Binding}" />
                </StackPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
    </StackPanel>

    <ScrollViewer Grid.Column="1" Grid.Row="0" Margin="24,0,0,0">
      <StackPanel Spacing="6">
        <TextBlock Text="Ficha del médico" Classes="titulo" />
        <TextBlock Classes="suave" TextWrapping="Wrap"
                   Text="Editar estos datos se refleja en todos los pacientes y tratamientos que lo referencian: no hay copia (FR-035)." />
        <TextBlock Text="Apellidos *" Classes="etiqueta" />
        <TextBox Text="{Binding Apellidos}" />
        <TextBlock Text="Nombre *" Classes="etiqueta" />
        <TextBox Text="{Binding Nombre}" />
        <TextBlock Text="Nº de colegiado" Classes="etiqueta" />
        <TextBox Text="{Binding Colegiado}" />
        <TextBlock Text="Especialidad" Classes="etiqueta" />
        <TextBox Text="{Binding Especialidad}" Watermark="Medicina de familia" />
        <TextBlock Text="Centro" Classes="etiqueta" />
        <TextBox Text="{Binding Centro}" />
        <TextBlock Text="Teléfono" Classes="etiqueta" />
        <TextBox Text="{Binding Telefono}" />
        <TextBlock Text="Email" Classes="etiqueta" />
        <TextBox Text="{Binding Email}" />
        <TextBlock Text="Dirección" Classes="etiqueta" />
        <TextBox Text="{Binding Direccion}" />
        <Button Classes="primario" Content="Guardar" Command="{Binding GuardarCommand}"
                Margin="0,12,0,0" HorizontalAlignment="Left" />
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="1" Grid.ColumnSpan="2" Classes="panel" Margin="0,12,0,0"
            IsVisible="{Binding Mensaje, Converter={x:Static ObjectConverters.IsNotNull}}">
      <TextBlock Text="{Binding Mensaje}" TextWrapping="Wrap" />
    </Border>
  </Grid>
</UserControl>
