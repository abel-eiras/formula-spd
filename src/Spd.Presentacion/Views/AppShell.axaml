<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:Spd.Presentacion.Controles"
        xmlns:p="using:Spd.Presentacion"
        x:Class="Spd.Presentacion.Views.AppShell"
        Icon="/Assets/formula-spd.ico"
        Title="{x:Static p:VersionAplicacion.TituloPrincipal}"
        Width="1180" Height="760" MinWidth="900" MinHeight="600">

  <Grid ColumnDefinitions="230,*">

    <Border Grid.Column="0" Background="{DynamicResource SuperficieAlterna}"
            BorderBrush="{DynamicResource Linea}" BorderThickness="0,0,1,0">
      <DockPanel Margin="10,12">
        <StackPanel DockPanel.Dock="Top">
          <TextBlock Text="{x:Static p:VersionAplicacion.Nombre}" Classes="pagina" Margin="10,0,10,2" />
          <TextBlock Text="{Binding Saludo}" Classes="etiqueta" Margin="10,0,10,14" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Spacing="2">
          <Border Classes="separador" Margin="0,10,0,8" />
          <Button Classes="navegacion" Content="Ayuda (F1)" Command="{Binding AbrirAyudaCommand}" />
          <Button Classes="navegacion" Content="Cerrar sesión" Command="{Binding CerrarSesionCommand}" />
        </StackPanel>

        <ScrollViewer>
          <StackPanel Spacing="2">
            <ItemsControl ItemsSource="{Binding ItemsTrabajo}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Classes="navegacion" Classes.activa="{Binding EsActiva}"
                          Command="{Binding DataContext.NavegarCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                          CommandParameter="{Binding}">
                    <DockPanel>
                      <c:Pastilla DockPanel.Dock="Right" Variante="Aviso"
                                  Texto="{Binding ContadorTexto}" IsVisible="{Binding TieneContador}" />
                      <TextBlock Text="{Binding Titulo}" VerticalAlignment="Center" />
                    </DockPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Administración" Classes="etiqueta" Margin="10,16,0,4"
                       IsVisible="{Binding EsAdministrador}" />
            <ItemsControl ItemsSource="{Binding ItemsAdministracion}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Classes="navegacion" Classes.activa="{Binding EsActiva}"
                          Command="{Binding DataContext.NavegarCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                          CommandParameter="{Binding}"
                          Content="{Binding Titulo}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <Grid Grid.Column="1" RowDefinitions="Auto,*" Background="{DynamicResource Fondo}">
      <Border Grid.Row="0" Padding="24,12" BorderBrush="{DynamicResource Linea}" BorderThickness="0,0,0,1"
              Background="{DynamicResource Superficie}">
        <DockPanel>
          <Button DockPanel.Dock="Left" Classes="enlace" Content="← Atrás" Margin="0,0,12,0"
                  Command="{Binding AtrasCommand}" IsVisible="{Binding PuedeVolver}" />

          <!-- FR-1520: la búsqueda global vive en la cabecera, disponible desde cualquier sección. -->
          <TextBox DockPanel.Dock="Right" Width="300" Name="CampoBusqueda"
                   Text="{Binding TextoBusqueda}"
                   Watermark="Buscar paciente, medicamento o blíster…" />

          <TextBlock Text="{Binding TituloSeccion}" Classes="titulo" VerticalAlignment="Center" />
        </DockPanel>
      </Border>

      <Grid Grid.Row="1">
        <ContentControl Name="RegionContenido" Content="{Binding Contenido}" />

        <!-- FR-1521/1522: los resultados se despliegan sobre el contenido, sin ventana ni cambio
             de sección, y solo mientras hay algo que mostrar. -->
        <Border IsVisible="{Binding BusquedaAbierta}" Classes="tarjeta"
                HorizontalAlignment="Right" VerticalAlignment="Top" Width="380"
                Margin="0,6,24,0" Padding="0" ZIndex="10">
          <StackPanel>
            <ItemsControl ItemsSource="{Binding ResultadosBusqueda}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Classes="navegacion" HorizontalContentAlignment="Stretch"
                          Command="{Binding DataContext.AbrirResultadoCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                          CommandParameter="{Binding}">
                    <StackPanel Spacing="1">
                      <TextBlock Text="{Binding Titulo}" />
                      <TextBlock Text="{Binding Detalle}" Classes="etiqueta" TextWrapping="Wrap" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Classes="enlace" Content="Cerrar" Margin="12,4,12,8"
                    Command="{Binding CerrarBusquedaCommand}" />
          </StackPanel>
        </Border>
      </Grid>
    </Grid>

  </Grid>
</Window>
