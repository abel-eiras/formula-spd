<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Spd.Presentacion.Controles"
             x:Class="Spd.Presentacion.Views.RetiradaEnvasesView">
  <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" Margin="24,20">
    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
      <CheckBox Content="Solo pacientes con faltantes" IsChecked="{Binding SoloConFaltantes}" />
      <Button Content="Recalcular" Command="{Binding RecalcularCommand}" />
      <Button Content="Imprimir" Command="{Binding ImprimirCommand}" />
    </StackPanel>

    <!-- FR-1511: al llegar desde un aviso de faltantes el listado se abre centrado en ese
         paciente; se dice en pantalla y se puede quitar, para que nadie crea que faltan filas. -->
    <Border Grid.Row="1" Classes="panel" Margin="0,10,0,0" IsVisible="{Binding HayFiltroDePaciente}">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <c:Pastilla Variante="Acento" Texto="{Binding NombrePacienteFiltrado}" VerticalAlignment="Center" />
        <TextBlock Text="Se muestran solo las líneas de este paciente." Classes="suave" VerticalAlignment="Center" />
        <Button Classes="enlace" Content="Ver todo el listado" Command="{Binding QuitarFiltroDePacienteCommand}" />
      </StackPanel>
    </Border>

    <DataGrid Grid.Row="2" Margin="0,12,0,0" ItemsSource="{Binding Filas}"
              AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="True">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Apellidos" Binding="{Binding Apellidos}" Width="2*" />
        <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*" />
        <!-- FR-532: el CIP estaba en la fila pero no en la tabla. -->
        <DataGridTextColumn Header="CIP" Binding="{Binding Cip}" Width="140" />
        <DataGridTextColumn Header="DNI retirada" Binding="{Binding DniRetirada}" Width="120" />
        <DataGridTextColumn Header="Medicamento" Binding="{Binding MedicamentoNombre}" Width="2*" />
        <DataGridTextColumn Header="Necesarias" Binding="{Binding Necesarias}" Width="100" CellStyleClasses="cifra" />
        <DataGridTextColumn Header="Disponibles" Binding="{Binding Disponibles}" Width="100" CellStyleClasses="cifra" />
        <DataGridTextColumn Header="Faltan" Binding="{Binding Faltan}" Width="80" CellStyleClasses="cifra" />
        <DataGridTextColumn Header="Envases" Binding="{Binding EnvasesARetirar}" Width="90" CellStyleClasses="cifra" />
        <DataGridTextColumn Header="Retirada" Binding="{Binding ProximaRetirada, StringFormat='{}{0:dd/MM/yyyy}'}" Width="120" />
        <DataGridTemplateColumn Header="" Width="150" CanUserSort="False">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <Button Classes="enlace" Content="Registrar envase" VerticalAlignment="Center"
                      Command="{Binding DataContext.PrepararRegistroCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                      CommandParameter="{Binding}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>

    <Border Grid.Row="3" Classes="panel" Margin="0,12,0,0"
            IsVisible="{Binding FilaSeleccionadaParaRegistrar, Converter={x:Static ObjectConverters.IsNotNull}}">
      <StackPanel Spacing="6">
        <TextBlock Text="{Binding FilaSeleccionadaParaRegistrar.MedicamentoNombre, StringFormat='Registrar envase: {0}'}"
                   Classes="etiqueta" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBox Watermark="Serie" Text="{Binding Serie}" />
          <TextBox Watermark="Lote" Text="{Binding Lote}" />
          <DatePicker SelectedDate="{Binding Caducidad}" />
          <NumericUpDown Value="{Binding UnidadesIniciales}" Minimum="0" Watermark="Unidades" />
          <Button Classes="primario" Content="Guardar" Command="{Binding ConfirmarRegistroCommand}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Grid.Row="4" Classes="panel" Margin="0,12,0,0"
            IsVisible="{Binding Mensaje, Converter={x:Static ObjectConverters.IsNotNull}}">
      <TextBlock Text="{Binding Mensaje}" TextWrapping="Wrap" />
    </Border>
  </Grid>
</UserControl>
