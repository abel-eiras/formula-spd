<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Spd.Presentacion.ViewModels"
        xmlns:app="using:Spd.Aplicacion"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Spd.Presentacion.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Spd.Presentacion"
        Width="900" Height="640">

    <Grid ColumnDefinitions="260,*" Margin="16">
        <StackPanel Grid.Column="0" Spacing="8">
            <TextBlock Text="{Binding Greeting}" FontSize="18" />
            <Button Content="Pacientes" Command="{Binding AbrirPacientesCommand}" />
            <Button Content="Preparaciones" Command="{Binding AbrirPreparacionesCommand}" />
            <Button Content="Retirada de envases" Command="{Binding AbrirRetiradaEnvasesCommand}" />
            <Button Content="Exportar pacientes" Command="{Binding AbrirExportarPacientesCommand}" />
            <Button Content="Catálogo de medicamentos" Command="{Binding AbrirCatalogoMedicamentosCommand}" />
            <Button Content="Registros de calidad" Command="{Binding AbrirRegistrosCalidadCommand}" />
            <Button Content="Configuración de usuarios" Command="{Binding AbrirUsuariosCommand}"
                    IsVisible="{Binding PuedeAccederAConfiguracion}" />
            <Button Content="Configuración de la farmacia" Command="{Binding AbrirFarmaciaCommand}"
                    IsVisible="{Binding PuedeAccederAConfiguracion}" />
            <Button Content="Actualizaciones" Command="{Binding AbrirActualizacionesCommand}"
                    IsVisible="{Binding PuedeAccederAConfiguracion}" />
            <Button Content="Nomenclátor" Command="{Binding AbrirNomenclatorCommand}"
                    IsVisible="{Binding PuedeAccederAConfiguracion}" />
            <Button Content="Control documental" Command="{Binding AbrirControlDocumentalCommand}"
                    IsVisible="{Binding PuedeAccederAConfiguracion}" />
            <Button Content="Seguridad" Command="{Binding AbrirSeguridadCommand}"
                    IsVisible="{Binding PuedeAccederAConfiguracion}" />
            <Button Content="Perfiles de importación" Command="{Binding AbrirPerfilesImportacionCommand}"
                    IsVisible="{Binding PuedeAccederAConfiguracion}" />
            <Button Content="Ayuda (F1)" Command="{Binding AbrirAyudaCommand}" Margin="0,16,0,0" />
            <Button Content="Cerrar sesión" Command="{Binding CerrarSesionCommand}" />
        </StackPanel>

        <Border Grid.Column="1" Margin="16,0,0,0" Padding="12" Background="#22808080">
            <Grid RowDefinitions="Auto,*">
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Avisos del día" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                    <Button Content="Actualizar avisos" FontSize="11" Command="{Binding RecargarAvisosCommand}" />
                </StackPanel>
                <ScrollViewer Grid.Row="1" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Text="Sin avisos: nada pendiente." Foreground="Gray" IsVisible="{Binding !Avisos.Count}" />
                        <ItemsControl ItemsSource="{Binding Avisos}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="app:AvisoInicio">
                                    <StackPanel Margin="0,3">
                                        <TextBlock Text="{Binding Tipo}" FontWeight="Bold" FontSize="11" />
                                        <TextBlock Text="{Binding Texto}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>

</Window>
