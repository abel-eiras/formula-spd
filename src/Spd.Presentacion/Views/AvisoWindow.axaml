<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Spd.Presentacion.Views.AvisoWindow"
        Title="Aviso"
        Icon="/Assets/formula-spd.ico"
        Width="420" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="16" Spacing="16">
    <TextBlock Name="TextoMensaje" TextWrapping="Wrap" />
    <Button Name="BotonAceptar" Content="Aceptar" HorizontalAlignment="Right" />
  </StackPanel>
</Window>
