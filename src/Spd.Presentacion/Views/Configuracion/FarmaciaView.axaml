<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Spd.Presentacion.Views.Configuracion.FarmaciaView">
  <ScrollViewer>
    <StackPanel Spacing="8" Margin="24">
      <TextBlock Text="Datos de la farmacia" FontSize="18" FontWeight="Bold" />
      <TextBlock Text="Código sanitario *" />
      <TextBox Text="{Binding CodigoSanitario}" />
      <TextBlock Text="Nombre *" />
      <TextBox Text="{Binding Nombre}" />
      <TextBlock Text="Titular o comunidad de bienes *" />
      <TextBox Text="{Binding TitularOComunidadBienes}" />
      <TextBlock Text="CIF *" />
      <TextBox Text="{Binding Cif}" />
      <TextBlock Text="Dirección *" />
      <TextBox Text="{Binding Direccion}" />
      <TextBlock Text="Código postal *" />
      <TextBox Text="{Binding Cp}" />
      <TextBlock Text="Población *" />
      <TextBox Text="{Binding Poblacion}" />
      <TextBlock Text="Teléfono *" />
      <TextBox Text="{Binding Telefono}" />
      <TextBlock Text="Fax" />
      <TextBox Text="{Binding Fax}" />
      <TextBlock Text="Email" />
      <TextBox Text="{Binding Email}" />
      <TextBlock Text="WhatsApp" />
      <TextBox Text="{Binding Whatsapp}" />

      <Separator Margin="0,8" />
      <TextBlock Text="Logo" FontSize="18" FontWeight="Bold" />
      <TextBlock Text="{Binding Logo}" Foreground="Gray" />
      <TextBlock Text="Ruta del nuevo logo" />
      <TextBox Text="{Binding RutaNuevoLogo}" />
      <Button Content="Aplicar nuevo logo" Command="{Binding AplicarNuevoLogoCommand}" />

      <Separator Margin="0,8" />
      <TextBlock Text="Prefijos de numeración" FontSize="18" FontWeight="Bold" />
      <TextBlock Text="Prefijo de nº de ficha (pacientes)" />
      <TextBox Text="{Binding PrefijoNumFicha}" />
      <TextBlock Text="Prefijo de nº de SPD (blísteres)" />
      <TextBox Text="{Binding PrefijoNumSpd}" />

      <Separator Margin="0,8" />
      <TextBlock Text="Rutas" FontSize="18" FontWeight="Bold" />
      <TextBlock Text="Carpeta de copias de seguridad" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBox Text="{Binding RutaBackup}" Width="320" />
        <Button Content="Validar" Command="{Binding ValidarRutaBackupCommand}" />
      </StackPanel>
      <TextBlock Text="Carpeta de documentos generados" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBox Text="{Binding RutaDocumentosGenerados}" Width="320" />
        <Button Content="Validar" Command="{Binding ValidarRutaDocumentosCommand}" />
      </StackPanel>

      <Button Content="Guardar" Command="{Binding GuardarCommand}" Margin="0,16,0,0" />
      <TextBlock Text="{Binding Mensaje}" TextWrapping="Wrap"
                 IsVisible="{Binding Mensaje, Converter={x:Static ObjectConverters.IsNotNull}}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
