<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Spd.Presentacion.Views.Configuracion.SeguridadView">
  <StackPanel Margin="16" Spacing="12">
    <TextBlock Text="Seguridad" FontSize="18" FontWeight="Bold" />
    <TextBlock Text="{Binding CifradoActivo, StringFormat='Cifrado de la base de datos: {0}'}" />

    <Separator Margin="0,8" />

    <StackPanel IsVisible="{Binding !HayFraseParaConfirmar}" Spacing="8">
      <TextBlock Text="Contraseña maestra actual (para cambiarla o desactivar el cifrado)" />
      <TextBox Text="{Binding ContrasenaActual}" PasswordChar="*" />
      <TextBlock Text="Contraseña maestra nueva" />
      <TextBox Text="{Binding ContrasenaNueva}" PasswordChar="*" />
      <TextBlock Text="Repetir contraseña maestra nueva" />
      <TextBox Text="{Binding ContrasenaNuevaConfirmacion}" PasswordChar="*" />

      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
        <Button Content="Activar cifrado" Command="{Binding IniciarActivacionCommand}"
                IsVisible="{Binding !CifradoActivo}" />
        <Button Content="Cambiar contraseña maestra" Command="{Binding IniciarCambioContrasenaCommand}"
                IsVisible="{Binding CifradoActivo}" />
        <Button Content="Desactivar cifrado" Command="{Binding DesactivarCommand}"
                IsVisible="{Binding CifradoActivo}" />
      </StackPanel>
    </StackPanel>

    <StackPanel IsVisible="{Binding HayFraseParaConfirmar}" Spacing="8">
      <TextBlock Text="Clave de recuperación (imprímala o guárdela ahora — no volverá a mostrarse):"
                 FontWeight="Bold" TextWrapping="Wrap" />
      <TextBox Text="{Binding FraseGeneradaTexto}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" Height="80" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Ya la he guardado, continuar" Command="{Binding ConfirmarFraseGuardadaCommand}" />
        <Button Content="Cancelar" Command="{Binding CancelarConfirmacionCommand}" />
      </StackPanel>
    </StackPanel>

    <Border Padding="8" Background="#22808080" IsVisible="{Binding Mensaje, Converter={x:Static ObjectConverters.IsNotNull}}">
      <TextBlock Text="{Binding Mensaje}" TextWrapping="Wrap" />
    </Border>
  </StackPanel>
</UserControl>
