<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:medicos="using:Spd.Presentacion.Views.Medicos"
             xmlns:medicamentos="using:Spd.Presentacion.Views.Medicamentos"
             xmlns:c="using:Spd.Presentacion.Controles"
             x:Class="Spd.Presentacion.Views.Pacientes.TratamientoView">
  <Grid>
  <Grid ColumnDefinitions="280,*" RowDefinitions="*,Auto" Margin="16">
    <StackPanel Grid.Column="0" Spacing="8">
      <TextBlock Text="Tratamientos vigentes" FontSize="16" FontWeight="Bold" />
      <Button Content="Nuevo tratamiento" Command="{Binding NuevoTratamientoCommand}" />
      <ListBox ItemsSource="{Binding Vigentes}">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="0,4" Spacing="2">
              <TextBlock Text="{Binding NombreMedicamento}" FontWeight="Bold" />
              <Button Content="Cambiar pauta" FontSize="11"
                      Command="{Binding DataContext.PrepararCambioDePautaCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                      CommandParameter="{Binding}" />
              <Button Content="Comunicar incidencia" FontSize="11"
                      Command="{Binding DataContext.ComunicarIncidenciaCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                      CommandParameter="{Binding}" />
              <!-- Spec 004 FR-410/CA-402: qué tomaba y desde cuándo. Un cambio de pauta cierra el
                   tratamiento y abre otro, así que esta es la única forma de verlo entero. -->
              <Button Content="Ver historial" FontSize="11"
                      Command="{Binding DataContext.VerHistorialCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                      CommandParameter="{Binding}" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </StackPanel>

    <ScrollViewer Grid.Column="1" Margin="24,0,0,0">
      <StackPanel Spacing="8">
        <TextBlock Text="{Binding EsCambioDePauta, StringFormat='Cambio de pauta: {0}'}" FontWeight="Bold" />
        <TextBlock Text="Medicamento *" />
        <medicamentos:SelectorMedicamentoView DataContext="{Binding SelectorMedicamento}" />
        <CheckBox Content="En el blíster (SPD)" IsChecked="{Binding EnSpd}" />
        <TextBlock Text="Problema de salud / indicación" />
        <TextBox Text="{Binding ProblemaSalud}" />
        <TextBlock Text="Médico prescriptor" />
        <medicos:SelectorMedicoView DataContext="{Binding SelectorMedico}" />
        <!-- Spec 004 FR-402 (revisado 2026-09-14): la dosis se teclea, con vocabulario cerrado. -->
        <TextBlock Text="Pauta" Classes="etiqueta" />
        <Grid ColumnDefinitions="Auto,Auto,Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8">
          <TextBlock Grid.Column="0" Text="Desayuno" Classes="etiqueta" />
          <TextBlock Grid.Column="1" Text="Almuerzo" Classes="etiqueta" />
          <TextBlock Grid.Column="2" Text="Cena" Classes="etiqueta" />
          <TextBlock Grid.Column="3" Text="Noche" Classes="etiqueta" />
          <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding PautaD}" Width="72" Classes="datos" />
          <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding PautaA}" Width="72" Classes="datos" />
          <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding PautaC}" Width="72" Classes="datos" />
          <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding PautaN}" Width="72" Classes="datos" />
        </Grid>
        <TextBlock Classes="suave" TextWrapping="Wrap"
                   Text="{Binding ValoresAdmitidos, StringFormat='Admite: {0}. Vacío si no hay toma.'}" />
        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Bloqueo}" IsVisible="{Binding HayPautaErronea}"
                   Text="Alguna dosis no está entre los valores admitidos: no se podrá guardar así." />
        <TextBlock Text="Pauta en texto libre (solo si no va en el blíster)" />
        <TextBox Text="{Binding PautaTexto}" />
        <TextBlock Text="Días de la semana (LMXJVSD, 1=sí)" />
        <TextBox Text="{Binding DiasSemana}" />
        <TextBlock Text="Vía" />
        <TextBox Text="{Binding Via}" />
        <TextBlock Text="Momento de administración" />
        <TextBox Text="{Binding Momento}" />
        <TextBlock Text="Tipo" />
        <ComboBox ItemsSource="{Binding TiposDisponibles}" SelectedItem="{Binding Tipo}" />

        <Button Content="Guardar" Command="{Binding GuardarCommand}" Margin="0,16,0,0" />
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="1" Grid.ColumnSpan="2" Padding="16,8" Background="#22808080"
            IsVisible="{Binding Mensaje, Converter={x:Static ObjectConverters.IsNotNull}}">
      <TextBlock Text="{Binding Mensaje}" TextWrapping="Wrap" />
    </Border>
  </Grid>

    <c:PanelLateral Titulo="{Binding HistorialDe}" IsVisible="{Binding HayHistorial}"
                    CerrarCommand="{Binding CerrarHistorialCommand}">
      <StackPanel Spacing="8">
        <TextBlock Classes="suave" TextWrapping="Wrap"
                   Text="Historial completo de este medicamento en el paciente, del más reciente al más antiguo. Cada cambio de pauta cierra un tramo y abre otro: nada se reescribe." />
        <ItemsControl ItemsSource="{Binding Historial}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Classes="tarjeta" Margin="0,0,0,8" Padding="0">
                <DockPanel>
                  <Border DockPanel.Dock="Left" Width="3" Background="{DynamicResource Linea}" />
                  <StackPanel Margin="12,10" Spacing="3">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding Periodo}" FontWeight="SemiBold" />
                      <c:Pastilla Texto="{Binding Estado}" Variante="{Binding Variante}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Classes="datos" Text="{Binding Pauta}" />
                    <TextBlock Classes="etiqueta" Text="{Binding Dias}" />
                    <TextBlock Classes="suave" TextWrapping="Wrap" Text="{Binding Motivo}"
                               IsVisible="{Binding TieneMotivo}" />
                  </StackPanel>
                </DockPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </c:PanelLateral>
  </Grid>
</UserControl>
