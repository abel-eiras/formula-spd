<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:medicos="using:Spd.Presentacion.Views.Medicos"
             xmlns:pacientes="using:Spd.Presentacion.Views.Pacientes"
             x:Class="Spd.Presentacion.Views.Pacientes.FichaPacienteView">
  <!-- Spec 015 FR-1530: la cabecera (ficha, estado, alergias) ya no está aquí, es la cabecera fija
       del espacio del paciente, y los siete botones que abrían ventanas son ahora pestañas. Lo que
       queda son los datos, en dos columnas para que quepan sin desplazar tanto. -->
  <Grid RowDefinitions="*,Auto">
    <ScrollViewer Grid.Row="0">
      <StackPanel Margin="24,20" Spacing="20">
      <Grid ColumnDefinitions="*,*" ColumnSpacing="28">

        <StackPanel Grid.Column="0" Spacing="6">
          <TextBlock Text="Identificación" Classes="titulo" Margin="0,0,0,4" />
          <TextBlock Text="Nombre *" Classes="etiqueta" />
          <TextBox Text="{Binding Nombre}" />
          <TextBlock Text="Apellidos *" Classes="etiqueta" />
          <TextBox Text="{Binding Apellidos}" />
          <TextBlock Text="Sexo (obligatorio si hay CIP)" Classes="etiqueta" />
          <ComboBox ItemsSource="{Binding SexosDisponibles}" SelectedItem="{Binding Sexo}" HorizontalAlignment="Stretch" />
          <TextBlock Text="DNI" Classes="etiqueta" />
          <TextBox Text="{Binding Dni}" />
          <TextBlock Text="Fecha de nacimiento" Classes="etiqueta" />
          <DatePicker SelectedDate="{Binding FechaNacimiento}" />
          <TextBlock Text="{Binding Edad, StringFormat='{}{0} años'}" Classes="suave"
                     IsVisible="{Binding Edad, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <TextBlock Text="Nº Seguridad Social" Classes="etiqueta" />
          <TextBox Text="{Binding NumSs}" />
          <TextBlock Text="CIP" Classes="etiqueta" />
          <TextBox Text="{Binding Cip}" />

          <TextBlock Text="Contacto" Classes="titulo" Margin="0,14,0,4" />
          <TextBlock Text="Dirección" Classes="etiqueta" />
          <TextBox Text="{Binding Direccion}" />
          <TextBlock Text="Código postal" Classes="etiqueta" />
          <TextBox Text="{Binding Cp}" />
          <TextBlock Text="Población" Classes="etiqueta" />
          <TextBox Text="{Binding Poblacion}" />
          <TextBlock Text="Teléfono 1" Classes="etiqueta" />
          <TextBox Text="{Binding Telefono1}" />
          <TextBlock Text="Teléfono 2" Classes="etiqueta" />
          <TextBox Text="{Binding Telefono2}" />
          <TextBlock Text="Email" Classes="etiqueta" />
          <TextBox Text="{Binding Email}" />

          <!-- FR-031/FR-032: médico de cabecera por nombre. Antes la ficha no tenía este campo y
               el alta guardaba siempre `MedicoId: null`. -->
          <TextBlock Text="Médico de cabecera" Classes="etiqueta" Margin="0,10,0,0" />
          <medicos:SelectorMedicoView DataContext="{Binding SelectorMedico}" />
        </StackPanel>

        <StackPanel Grid.Column="1" Spacing="6">
          <TextBlock Text="Clínica" Classes="titulo" Margin="0,0,0,4" />
          <TextBlock Text="Enfermedades crónicas" Classes="etiqueta" />
          <TextBox Text="{Binding EnfermedadesCronicas}" AcceptsReturn="True" Height="70" />
          <TextBlock Text="Alergias e intolerancias" Classes="etiqueta" />
          <TextBox Text="{Binding Alergias}" AcceptsReturn="True" Height="70" />
          <TextBlock Text="Observaciones" Classes="etiqueta" />
          <TextBox Text="{Binding Observaciones}" AcceptsReturn="True" Height="70" />

          <TextBlock Text="SPD" Classes="titulo" Margin="0,14,0,4" />
          <CheckBox Content="Pictogramas de comidas" IsChecked="{Binding PictogramaComidas}" />
          <TextBlock Text="Identificador visual" Classes="etiqueta" />
          <TextBox Text="{Binding IdentificadorVisual}" />
          <TextBlock Text="Día de retirada del SPD" Classes="etiqueta" />
          <ComboBox ItemsSource="{Binding DiasSemanaDisponibles}" SelectedItem="{Binding DiaRetirada}" HorizontalAlignment="Stretch" />
          <TextBlock Text="Nº de blísteres (1 o 2)" Classes="etiqueta" />
          <NumericUpDown Value="{Binding NBlisteres}" Minimum="1" Maximum="2" />

          <Button Classes="primario" Content="Guardar" Command="{Binding GuardarCommand}"
                  Margin="0,20,0,0" HorizontalAlignment="Left" />
        </StackPanel>

      </Grid>

      <!-- FR-009/FR-020: los contactos viven en esta misma pestaña, debajo de los datos. -->
      <Border Classes="separador" />
      <pacientes:ContactosPacienteView DataContext="{Binding Contactos}" />
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="1" Classes="panel" Margin="24,0,24,16"
            IsVisible="{Binding Mensaje, Converter={x:Static ObjectConverters.IsNotNull}}">
      <TextBlock Text="{Binding Mensaje}" TextWrapping="Wrap" />
    </Border>
  </Grid>
</UserControl>
