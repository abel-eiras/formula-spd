<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:Spd.Presentacion.Views"
        xmlns:p="using:Spd.Presentacion"
        x:Class="Spd.Presentacion.Views.LoginWindow"
        Title="{x:Static p:VersionAplicacion.TituloLogin}"
        Icon="/Assets/formula-spd.ico"
        Width="420" Height="400"
        CanResize="False">
  <views:LoginView />
</Window>
