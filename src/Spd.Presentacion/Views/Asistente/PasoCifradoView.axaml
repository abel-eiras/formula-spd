<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Spd.Presentacion.Views.Asistente.PasoCifradoView">
  <StackPanel Spacing="12" Margin="24">
    <TextBlock Text="Paso 1 de 5 — Cifrado" FontSize="20" FontWeight="Bold" />
    <TextBlock Text="¿Quieres cifrar la base de datos con una contraseña maestra?" TextWrapping="Wrap" />
    <CheckBox Content="Sí, quiero cifrar la base de datos" IsChecked="{Binding CifradoDeseado}" />
    <TextBlock TextWrapping="Wrap" Foreground="Gray"
               Text="El cifrado se activará cuando esté disponible (funcionalidad de una futura versión). Esta preferencia no impide continuar el asistente." />
  </StackPanel>
</UserControl>
