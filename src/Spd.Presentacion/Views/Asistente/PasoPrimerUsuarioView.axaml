<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Spd.Presentacion.Views.Asistente.PasoPrimerUsuarioView">
  <StackPanel Spacing="8" Margin="24">
    <TextBlock Text="Paso 3 de 5 — Primer usuario" FontSize="20" FontWeight="Bold" />
    <TextBlock Text="Este usuario tendrá siempre el rol Administrador." Foreground="Gray" />
    <TextBlock Text="Nombre *" />
    <TextBox Text="{Binding NombreUsuario}" />
    <TextBlock Text="Apellidos *" />
    <TextBox Text="{Binding ApellidosUsuario}" />
    <TextBlock Text="Usuario (login) *" />
    <TextBox Text="{Binding Login}" />
    <TextBlock Text="Contraseña *" />
    <TextBox Text="{Binding Password}" PasswordChar="•" />
  </StackPanel>
</UserControl>
