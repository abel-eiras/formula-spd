<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:Spd.Presentacion.Convertidores"
             x:Class="Spd.Presentacion.Views.Medicamentos.CatalogoMedicamentosView">
  <Grid ColumnDefinitions="1.6*,*" Margin="24,20" RowDefinitions="*,Auto">
    <StackPanel Grid.Column="0" Grid.Row="0" Spacing="8">
      <TextBlock Text="Catálogo de medicamentos" Classes="titulo" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBox Text="{Binding Fragmento}" Watermark="CN o nombre…" Width="240" />
        <Button Content="Nuevo" Command="{Binding NuevoMedicamentoCommand}" />
      </StackPanel>
      <Button Content="Revisar nomenclátor" Command="{Binding RevisarNomenclatorCommand}" />
      <TextBlock Classes="suave" TextWrapping="Wrap" IsVisible="{Binding FaltaBusqueda}"
                 Text="Escribe al menos dos letras del nombre, o el CN. El catálogo incluye todo el nomenclátor." />
      <TextBlock Classes="suave" TextWrapping="Wrap" IsVisible="{Binding HayMasResultados}"
                 Text="Se muestran los 50 primeros: afina la búsqueda para encontrar el que buscas." />
      <!-- FR-1512. Sin x:DataType a propósito: bindings por reflexión, evita el patrón frágil de
           $parent + cast de tipo con compiled bindings que provocó un cierre inesperado en
           Spec 000 (UsuariosView). -->
      <DataGrid ItemsSource="{Binding Resultados}" AutoGenerateColumns="False"
                IsReadOnly="True" CanUserSortColumns="True">
        <DataGrid.Columns>
          <DataGridTextColumn Header="CN" Binding="{Binding Cn}" Width="90" />
          <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="2*" />
          <DataGridTextColumn Header="Principio activo" Binding="{Binding PrincipioActivo}" Width="*" />
          <DataGridTemplateColumn Header="SPD" Width="110" CanUserSort="False">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding AptoSpd, Converter={x:Static conv:AptitudSpdConvertidor.Texto}}" VerticalAlignment="Center" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="" Width="160" CanUserSort="False">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <Button Classes="enlace" Content="Abrir"
                          Command="{Binding DataContext.SeleccionarMedicamentoCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                          CommandParameter="{Binding}" />
                  <Button Classes="enlace" Content="Dar de baja"
                          Command="{Binding DataContext.DarDeBajaCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                          CommandParameter="{Binding}" />
                </StackPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
    </StackPanel>

    <ScrollViewer Grid.Column="1" Grid.Row="0" Margin="24,0,0,0">
      <StackPanel Spacing="8">
        <TextBlock Text="CN *" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBox Text="{Binding Cn}" IsEnabled="{Binding EsAltaNueva}" Width="140" />
          <Button Content="Consultar CIMA" Command="{Binding ConsultarCimaCommand}"
                  IsEnabled="{Binding !ConsultandoCima}" />
        </StackPanel>
        <TextBlock Text="Nombre *" />
        <TextBox Text="{Binding Nombre}" />
        <TextBlock Text="Principio activo" />
        <TextBox Text="{Binding PrincipioActivo}" />
        <TextBlock Text="Laboratorio" />
        <TextBox Text="{Binding Laboratorio}" />
        <TextBlock Text="Forma farmacéutica" />
        <ComboBox ItemsSource="{Binding FormasDisponibles}" SelectedItem="{Binding FormaFarmaceutica}" />
        <CheckBox Content="Fraccionable" IsChecked="{Binding Fraccionable}" />
        <TextBlock Text="GTIN" />
        <TextBox Text="{Binding Gtin}" />
        <CheckBox Content="Apto para SPD (en blanco: sin confirmar)" IsThreeState="True" IsChecked="{Binding AptoSpd}" />
        <TextBlock Text="Motivo (obligatorio si la aptitud no coincide con la derivada de la forma)" />
        <TextBox Text="{Binding MotivoNoApto}" />
        <TextBlock Text="Unidades por envase" />
        <NumericUpDown Value="{Binding UnidadesEnvase}" Minimum="0" />

        <Separator Margin="0,8" />
        <TextBlock Text="Descripción física" Classes="titulo" />
        <TextBlock Text="Forma" />
        <TextBox Text="{Binding DescForma}" />
        <TextBlock Text="Color" />
        <TextBox Text="{Binding DescColor}" />
        <TextBlock Text="Ranura" />
        <TextBox Text="{Binding DescRanura}" />
        <TextBlock Text="Serigrafía" />
        <TextBox Text="{Binding DescSerigrafia}" />
        <TextBlock Text="Tamaño" />
        <TextBox Text="{Binding DescTamano}" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="Descripción (texto)" VerticalAlignment="Center" />
          <Button Content="Proponer" FontSize="11" Command="{Binding ProponerDescripcionCommand}" />
        </StackPanel>
        <TextBox Text="{Binding DescTexto}" AcceptsReturn="True" Height="60" />

        <Button Classes="primario" Content="Guardar" Command="{Binding GuardarCommand}" Margin="0,16,0,0" />
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="1" Grid.ColumnSpan="2" Classes="panel" Margin="0,12,0,0"
            IsVisible="{Binding Mensaje, Converter={x:Static ObjectConverters.IsNotNull}}">
      <TextBlock Text="{Binding Mensaje}" TextWrapping="Wrap" />
    </Border>
  </Grid>
</UserControl>
