<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Spd.Presentacion.Views.RegistrosCalidad.RegistroAmbientalView">
  <Grid ColumnDefinitions="260,*" Margin="16">
    <StackPanel Grid.Column="0" Spacing="4">
      <TextBlock Text="Registro ambiental" FontSize="16" FontWeight="Bold" />
      <TextBlock Text="Temperatura (°C)" />
      <NumericUpDown Value="{Binding Temperatura}" />
      <TextBlock Text="Humedad (%)" />
      <NumericUpDown Value="{Binding Humedad}" />
      <TextBlock Text="Observaciones" />
      <TextBox Text="{Binding Observaciones}" />
      <Button Content="Registrar" Command="{Binding RegistrarCommand}" Margin="0,8,0,0" />
      <TextBlock Text="{Binding Mensaje}" TextWrapping="Wrap"
                 IsVisible="{Binding Mensaje, Converter={x:Static ObjectConverters.IsNotNull}}" />
    </StackPanel>

    <ListBox Grid.Column="1" Margin="16,0,0,0" ItemsSource="{Binding Resultados}">
      <!-- Sin x:DataType a propósito: bindings por reflexión (mismo patrón que Specs 000/001/003). -->
      <ListBox.ItemTemplate>
        <DataTemplate>
          <StackPanel Margin="0,4" Spacing="2">
            <TextBlock Text="{Binding FechaHora}" FontWeight="Bold" />
            <TextBlock Text="{Binding Temperatura, StringFormat='{}{0} °C'}" />
            <TextBlock Text="{Binding Humedad, StringFormat='{}{0} %'}" />
            <TextBlock Text="Fuera de rango" Foreground="Red" IsVisible="{Binding FueraDeRango}" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Grid>
</UserControl>
