<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Spd.Dominio\Spd.Dominio.csproj" />
    <ProjectReference Include="..\Spd.Aplicacion\Spd.Aplicacion.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Scripts SQL numerados embebidos en el ensamblado (Art. VIII.3) -->
    <EmbeddedResource Include="Migraciones\*.sql" />
    <!-- Lista de palabras BIP39 en español (dominio público) para la clave de recuperación de
         24 palabras (research.md Decisión 4 de Spec 010) -->
    <EmbeddedResource Include="Recursos\wordlist-es.txt" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.79" />
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <!-- Fijado a 10.0.10, NO la última (10.0.11): research.md Decisión 1 de Spec 010 documenta
         una regresión reproducida en 10.0.11 que ignora silenciosamente un SQLite3Provider_e_sqlcipher
         registrado a mano, cayendo a SQLite normal sin cifrado real y sin ningún error visible. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlcipher" Version="2.1.11" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
